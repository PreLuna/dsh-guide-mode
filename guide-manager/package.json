{
  "name": "@local/dsh-guide-manager",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Product manager for the DSH guidance mode components with phase-4 skills manager integration",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "core.js",
    "install.js",
    "upgrade.js",
    "maintenance.js",
    "artifacts.js",
    "release.js",
    "github-source.js",
    "remote.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "helper/apply-pending.mjs",
    "helper/apply-install.mjs",
    "helper/apply-package.mjs",
    "helper/apply-maintenance.mjs",
    "helper/maintain-guide-manager.cmd",
    "helper/recover-manager.ps1",
    "helper/repair-components.ps1",
    "helper/update-guide-manager.cmd",
    "helper/install-guide-manager.cmd",
    "helper/restart-guide-manager.ps1",
    "helper/restart-guide-manager.cmd",
    "helper/reload-guide-manager.cmd",
    "helper/rollback-guide-manager.cmd"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dshGuide": {
    "controlSchema": 1,
    "dataSchema": 1,
    "product": "dsh-guide-mode",
    "release": "1.1.0",
    "readOnly": false,
    "actionScope": "phase-4",
    "components": {
      "@local/dsh-guide-preset": {
        "component": "preset",
        "contract": 1,
        "version": "1.1.0"
      },
      "@local/dsh-guide-shield": {
        "component": "shield",
        "contract": 1,
        "version": "1.1.0"
      },
      "@local/dsh-guide-admission": {
        "component": "admission",
        "contract": 1,
        "version": "1.1.0"
      },
      "@local/dsh-guide-panel": {
        "component": "panel",
        "contract": 1,
        "version": "1.1.0"
      },
      "@local/dsh-guide-sidebar-adapter": {
        "component": "sidebar",
        "contract": 1,
        "version": "1.1.0"
      },
      "@local/dsh-guide-goal-adapter": {
        "component": "goal",
        "contract": 1,
        "version": "1.1.0"
      }
    },
    "edges": [
      {
        "from": "panel",
        "to": "preset",
        "optional": false
      },
      {
        "from": "panel",
        "to": "admission",
        "optional": false
      },
      {
        "from": "panel",
        "to": "shield",
        "optional": false
      },
      {
        "from": "panel",
        "to": "sidebar",
        "optional": true
      },
      {
        "from": "goal",
        "to": "@deepseek-ai/dsh-goal-round-driver",
        "optional": false
      }
    ],
    "host": {
      "dsh": "0.2.1-rc.3",
      "build": "be72761",
      "cordis": "4.0.5",
      "betterSidebar": "0.28.2"
    },
    "artifacts": {
      "@deepseek-ai/dsh-subagent": {
        "file": "lib/index.js",
        "sha256": "9a9572e70fffdb100deb63326167f32bbf63016ce49c0017495dabcb95b44168"
      },
      "@deepseek-ai/cordis": {
        "file": "lib/index.js",
        "sha256": "6a9394c0877ff45218818c6e815edd038f8057e1a1deb390a8d43ec81c57691e"
      },
      "@deepseek-ai/dsh-goal-round-driver": {
        "file": "lib/index.js",
        "sha256": "255483fbf86bed0dac5f641d89684de1933695e2c034475b2fa3953ec7f1ff92"
      },
      "dsh-better-sidebar": {
        "file": "lib/client.js",
        "sha256": "dd93b4563f6fe3d384c0e8270fcf76656398ae358d18316a91aae4046bdf2432"
      },
      "@deepseek-ai/dsh-client-modules": {
        "file": "lib/client.js",
